+
+export type InspectorBinding = ObjectInspectorBinding | MultiObjectInspectorBinding | RelationshipInspectorBinding | FlowInspectorBinding;
+
+const SEVERITY_RANK: Record<SemanticState["severity"], number> = { neutral: 0, positive: 1, attention: 2, critical: 3 };
+
+function mergedSelectionState(objects: SemanticObject[]): SemanticState {
+  const uniqueLabels = new Map<string, SemanticState>();
+  for (const object of objects) uniqueLabels.set(object.state.label, object.state);
+  if (uniqueLabels.size === 1) return objects[0].state;
+  const states = [...uniqueLabels.values()];
+  const worst = states.reduce((left, right) => (SEVERITY_RANK[right.severity] > SEVERITY_RANK[left.severity] ? right : left));
+  return { value: "mixed", label: `Mixed · ${uniqueLabels.size} states`, severity: worst.severity, source: "knowledge" };
+}
+
+function bindMultiObjectInspector(graph: SemanticGraph, selection: Extract<CanvasSelection, { kind: "objects" }>): InspectorBinding | null {
+  const index = indexSemanticGraph(graph);
+  const objects = selection.ids
+    .map((id) => index.objectById.get(id))
+    .filter((object): object is SemanticObject => Boolean(object));
+  if (objects.length === 0) return null;
+  const regionNames = [...new Set(objects.map((object) => index.regionById.get(object.regionId)?.name ?? "Unscoped"))];
+  const location = regionNames.length <= 3 ? regionNames.join(" · ") : `${regionNames.slice(0, 3).join(" · ")} +${regionNames.length - 3}`;
+  return {
+    kind: "objects",
+    id: `objects:${objects.map((object) => object.id).join("+")}`,
+    title: `${objects.length} objects selected`,
+    typeLabel: "Multiple objects",
+    summary: `联合选择：影响按所选对象的上游依赖与下游受影响者的并集计算，重叠部分标记为共同影响。`,
+    state: mergedSelectionState(objects),
+    location,
+    raw: {
+      objectIds: objects.map((object) => object.id),
+      regions: regionNames,
+      objectTypes: [...new Set(objects.map((object) => object.objectType))],
+    },
+    objects,
+  };
+}
 
 export function bindInspector(graph: SemanticGraph, selection: CanvasSelection): InspectorBinding | null {
   if (!selection) return null;
   const index = indexSemanticGraph(graph);
+  if (selection.kind === "objects") return bindMultiObjectInspector(graph, selection);
   if (selection.kind === "object") {
     const object = index.objectById.get(selection.id);
     if (!object) return null;
