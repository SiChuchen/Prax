+    const projected = projectSemanticGraph(graph, stubLayout(graph), multi);
+    const nodeById = new Map(projected.nodes.filter((node) => node.type === "object").map((node) => [node.id, node]));
+    for (const subjectId of subjectIds) {
+      assert.equal(nodeById.get(subjectId)?.selected, true, "every selected object must project as selected");
+      assert.equal(nodeById.get(subjectId)?.data.impactSharedCount, undefined, "selected objects are subjects, not impact");
