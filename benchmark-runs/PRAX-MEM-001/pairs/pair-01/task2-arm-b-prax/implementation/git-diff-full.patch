+    for (const objectId of multiUnion) assert.equal(multi.objectEmphasis.get(objectId), "related", `impacted ${objectId} must stay figure`);
+    const impacted = new Set([...expected.upstream, ...expected.downstream]);
+    for (const object of graph.objects) {
