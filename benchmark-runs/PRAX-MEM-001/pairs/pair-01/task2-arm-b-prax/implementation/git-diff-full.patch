+function expectedImpact(graph, subjectIds) {
+  const subjects = new Set(subjectIds);
+  const contributingSubjects = new Map();
+  const union = { upstream: new Set(), downstream: new Set() };
+  const record = (selectedId, neighborId, direction) => {
+    if (!subjects.has(selectedId) || subjects.has(neighborId)) return;
+    union[direction].add(neighborId);
+    const set = contributingSubjects.get(neighborId) ?? new Set();
+    set.add(selectedId);
+    contributingSubjects.set(neighborId, set);
+  };
+  for (const relationship of graph.relationships) {
+    record(relationship.sourceObjectId, relationship.targetObjectId, "downstream");
+    record(relationship.targetObjectId, relationship.sourceObjectId, "upstream");
+    if (relationship.direction === "bidirectional") {
+      record(relationship.targetObjectId, relationship.sourceObjectId, "downstream");
+      record(relationship.sourceObjectId, relationship.targetObjectId, "upstream");
+    }
+  }
+  return {
+    upstream: union.upstream,
+    downstream: union.downstream,
+    shared: new Set([...contributingSubjects].filter(([, set]) => set.size > 1).map(([id]) => id)),
+    contributions: new Map([...contributingSubjects].map(([id, set]) => [id, set.size])),
+  };
+}
