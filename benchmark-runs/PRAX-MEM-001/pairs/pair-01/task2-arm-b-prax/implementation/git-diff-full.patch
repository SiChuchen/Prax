+      if (count > 1) sharedCounts[objectId] = count;
+    }
+    const shared = [...impact.sharedObjectIds]
+      .map((objectId) => {
+        const object = toObject(objectId);
+        return object ? { object, count: impact.impactCountByObjectId.get(objectId) ?? 0 } : null;
+      })
+      .filter((entry): entry is SharedImpactEntry => Boolean(entry))
+      .sort((left, right) => right.count - left.count || byName(left.object, right.object));
+    const regionCount = new Set(objects.map((object) => object.regionId)).size;
