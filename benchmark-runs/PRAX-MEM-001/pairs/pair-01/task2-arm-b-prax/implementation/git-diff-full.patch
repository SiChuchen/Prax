+      typeLabel: "selection",
+      summary: `${objects.length} objects across ${regionCount} region${regionCount === 1 ? "" : "s"}. Aggregate impact: ${upstream.length} upstream dependencies, ${downstream.length} downstream dependents${shared.length > 0 ? `, ${shared.length} shared by multiple selected objects` : ""}.`,
+      state: AGGREGATE_STATE,
