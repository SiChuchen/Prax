+test("multi-object selection unions impact and identifies shared impact", () => {
+  for (const graph of [SMALL_CANVAS_FIXTURE, MEDIUM_CANVAS_FIXTURE]) {
+    const hub = graph.objects[0];
+    const second = graph.objects[1];
+    const third = graph.objects[2];
+    const subjectIds = [hub.id, second.id, third.id];
+
+    const singleViews = subjectIds.map((id) => deriveCanvasView(graph, {
+      mode: "inspect",
+      selection: { kind: "object", id },
+      activeFlowId: null,
+      zoom: .9,
+      searchQuery: "",
+    }));
+    const multi = deriveCanvasView(graph, {
+      mode: "inspect",
+      selection: { kind: "objects", ids: subjectIds },
+      activeFlowId: null,
+      zoom: .9,
+      searchQuery: "",
+    });
+
+    const expected = expectedImpact(graph, subjectIds);
+    assert.equal(multi.impact.subjectIds.length, 3, "aggregate impact must carry every selected subject");
+    assert.equal(multi.impact.subjectId, subjectIds[0], "single-select contract keeps a subjectId anchor");
+    assert.deepEqual([...multi.impact.upstreamObjectIds].sort(), [...expected.upstream].sort());
+    assert.deepEqual([...multi.impact.downstreamObjectIds].sort(), [...expected.downstream].sort());
+    assert.deepEqual([...multi.impact.sharedObjectIds].sort(), [...expected.shared].sort(), "shared must be exactly the objects impacted by more than one selected object");
+    for (const [objectId, count] of expected.contributions) {
+      assert.equal(multi.impact.impactCountByObjectId.get(objectId), count, `contribution count for ${objectId}`);
+    }
+    const unionFromSingles = new Set();
+    for (const view of singleViews) {
+      for (const id of view.impact.upstreamObjectIds) unionFromSingles.add(id);
+      for (const id of view.impact.downstreamObjectIds) unionFromSingles.add(id);
+    }
+    const multiUnion = new Set([...multi.impact.upstreamObjectIds, ...multi.impact.downstreamObjectIds]);
+    assert.deepEqual([...unionFromSingles].filter((id) => !subjectIds.includes(id)).sort(), [...multiUnion].sort(), "aggregate union must equal the per-object union minus the selection itself");
