+test("multi-select impact unions closures and flags shared dependents", () => {
+  const view = (mode, selection) => deriveCanvasView(SMALL_CANVAS_FIXTURE, { mode, selection, activeFlowId: null, zoom: .9, searchQuery: "" });
+
+  let pair = null;
+  let sharedId = null;
+  for (let i = 0; i < SMALL_CANVAS_FIXTURE.objects.length && !pair; i += 1) {
+    for (let j = i + 1; j < SMALL_CANVAS_FIXTURE.objects.length && !pair; j += 1) {
+      const a = SMALL_CANVAS_FIXTURE.objects[i].id;
+      const b = SMALL_CANVAS_FIXTURE.objects[j].id;
+      const impactA = view("inspect", { kind: "object", id: a }).impact;
+      const impactB = view("inspect", { kind: "object", id: b }).impact;
+      if (!impactA || !impactB) continue;
+      const reachA = new Set([...impactA.upstream.keys(), ...impactA.downstream.keys()]);
+      const overlap = [...reachA].find((id) => (impactB.upstream.has(id) || impactB.downstream.has(id)) && id !== a && id !== b);
+      if (overlap) { pair = [a, b]; sharedId = overlap; }
+    }
+  }
+  assert.ok(pair, "Small fixture must contain a pair with overlapping impact");
+
+  const singleA = view("inspect", { kind: "object", id: pair[0] });
+  const singleB = view("inspect", { kind: "object", id: pair[1] });
+  const multi = view("inspect", { kind: "objects", ids: pair });
+  assert.ok(multi.impact);
+  assert.deepEqual(multi.impact.rootIds, pair);
+  assert.equal(singleA.impact.sharedObjectIds.size, 0, "A single root can never produce shared impact");
+
+  const expectedUpstream = new Set([...singleA.impact.upstream.keys(), ...singleB.impact.upstream.keys()]);
+  const expectedDownstream = new Set([...singleA.impact.downstream.keys(), ...singleB.impact.downstream.keys()]);
+  for (const id of pair) { expectedUpstream.delete(id); expectedDownstream.delete(id); }
+  assert.deepEqual(new Set(multi.impact.upstream.keys()), expectedUpstream, "Upstream must be the union of both closures minus the anchors");
+  assert.deepEqual(new Set(multi.impact.downstream.keys()), expectedDownstream, "Downstream must be the union of both closures minus the anchors");
+
+  assert.ok(multi.impact.sharedObjectIds.has(sharedId), "Overlapping dependent must be flagged as shared impact");
+  for (const id of multi.impact.sharedObjectIds) {
+    const contributors = new Set([...(multi.impact.upstreamRoots.get(id) ?? []), ...(multi.impact.downstreamRoots.get(id) ?? [])]);
+    assert.ok(contributors.size >= 2, "Shared impact must be attributed to at least two selected roots");
+  }
+  assert.equal(multi.objectEmphasis.get(pair[0]), "primary");
+  assert.equal(multi.objectEmphasis.get(pair[1]), "primary");
+  assert.notEqual(multi.objectEmphasis.get(sharedId), "muted", "Shared dependents must stay readable");
+
+  const binding = bindInspector(SMALL_CANVAS_FIXTURE, { kind: "objects", ids: pair }, multi.impact);
+  assert.equal(binding?.kind, "objects");
+  assert.equal(binding?.aggregate.upstreamCount, multi.impact.upstream.size);
+  assert.equal(binding?.aggregate.downstreamCount, multi.impact.downstream.size);
+  assert.equal(binding?.aggregate.sharedCount, multi.impact.sharedObjectIds.size);
+  assert.ok(binding?.aggregate.shared.some((row) => row.id === sharedId));
+
+  assert.equal(bindInspector(SMALL_CANVAS_FIXTURE, null), null, "Empty selection must return the Inspector to idle");
+  assert.equal(view("browse", null).impact, null, "No selection means no impact lens");
+
+  const landscape = deriveCanvasView(SMALL_CANVAS_FIXTURE, { mode: "inspect", selection: { kind: "objects", ids: pair }, activeFlowId: null, zoom: .24, searchQuery: "" });
+  const landscapeVisible = visibleObjectIds(SMALL_CANVAS_FIXTURE, landscape);
+  for (const id of [...pair, ...landscape.impact.objectRoles.keys()]) {
+    assert.ok(landscapeVisible.has(id), "Landscape must keep multi impact objects visible");
+  }
+});
