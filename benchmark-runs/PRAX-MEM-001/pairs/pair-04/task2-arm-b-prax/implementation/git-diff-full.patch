+};
+
+const layoutMemory = new Map<string, CanvasLayout>();
+
+function latestModel<T extends { lifecycleStatus: string }>(
+  active: T[],
+  pending: T[],
+  key: (item: T) => string,
+  showPending: boolean,
+) {
+  if (!showPending) return active;
+  const result = new Map(active.map((item) => [key(item), item]));
+  for (const item of pending) result.set(key(item), item);
+  return [...result.values()];
+}
+
+function revisionSnapshot<T extends { validFromRevision: number; validToRevision: number | null; lifecycleStatus: string }>(
+  rows: T[],
+  revision: number,
+  currentRevision: number,
+) {
+  if (revision === currentRevision) return rows.filter((row) => row.lifecycleStatus === "ACTIVE");
+  return atRevision(rows.filter((row) => row.lifecycleStatus !== "PENDING"), revision);
+}
+
+function sameEntity(left: ArchitectureEntity, right: ArchitectureEntity) {
+  return left.name === right.name
+    && left.summary === right.summary
+    && left.entityType === right.entityType
+    && left.parentEntityKey === right.parentEntityKey
+    && left.technology === right.technology
+    && left.repositoryRefsJson === right.repositoryRefsJson
+    && left.knowledgeState === right.knowledgeState;
+}
+
+function layoutStorageKey(graph: SemanticGraph) {
+  return `ecp:canvas-engine-v1-readable:${graph.scope.projectId}:r${graph.scope.revision}`;
+}
+
+function readLayout(key: string, fingerprint: string) {
+  try {
+    const parsed = JSON.parse(window.localStorage.getItem(key) ?? "null") as CanvasLayout | null;
+    return parsed?.fingerprint === fingerprint ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+function writeLayout(key: string, layout: CanvasLayout) {
+  layoutMemory.set(`${key}:${layout.fingerprint}`, layout);
+  try {
+    window.localStorage.setItem(key, JSON.stringify(layout));
+  } catch {
+    // Storage is a convenience, never a canonical architecture write.
+  }
+}
+
+export default function ArchitectureCanvas({
+  detail,
+  graphOverride,
+}: {
+  detail?: ProjectDetail;
+  graphOverride?: SemanticGraph;
+}) {
+  const architecture = detail?.architecture ?? EMPTY_ARCHITECTURE;
+  const currentRevision = detail?.project.revision ?? graphOverride?.scope.revision ?? 1;
+  const revisionOptions = useMemo(() => {
+    if (!detail) return [currentRevision];
+    const known = detail.revisions.map((revision) => revision.revisionNumber).filter((revision) => revision <= currentRevision);
+    return [...new Set([...known, currentRevision])].sort((left, right) => left - right);
+  }, [currentRevision, detail]);
+  const [revisionIndex, setRevisionIndex] = useState(Math.max(0, revisionOptions.length - 1));
+  const viewRevision = revisionOptions[Math.min(revisionIndex, revisionOptions.length - 1)] ?? currentRevision;
+  const isCurrentRevision = viewRevision === currentRevision;
+  const [playingTimeline, setPlayingTimeline] = useState(false);
+  const [showPending, setShowPending] = useState(false);
+  const [flowLensOpen, setFlowLensOpen] = useState(false);
+  const [layouting, setLayouting] = useState(true);
+  const [layoutError, setLayoutError] = useState("");
+  const [layoutReset, setLayoutReset] = useState(0);
+  const [layout, setLayout] = useState<CanvasLayout | null>(null);
+  const [interaction, setInteraction] = useState<CanvasInteractionState>({
+    mode: "browse",
+    selection: null,
+    activeFlowId: null,
+    zoom: 0.68,
+    searchQuery: "",
+  });
+  const [nodes, setNodes, onNodesChange] = useNodesState<CanvasNode>([]);
+  const [edges, setEdges, onEdgesChange] = useEdgesState<CanvasRelationshipEdge>([]);
+  const instanceRef = useRef<ReactFlowInstance<CanvasNode, CanvasRelationshipEdge> | null>(null);
+  const canvasRef = useRef<HTMLDivElement | null>(null);
+  const previousLayoutRef = useRef<CanvasLayout | null>(null);
+  const fittedLayoutRef = useRef("");
+  const cameraIntentRef = useRef("");
+
+  const baseEntities = useMemo(
+    () => revisionSnapshot(architecture.entities, viewRevision, currentRevision),
+    [architecture.entities, currentRevision, viewRevision],
+  );
+  const baseRelations = useMemo(
+    () => revisionSnapshot(architecture.relations, viewRevision, currentRevision),
+    [architecture.relations, currentRevision, viewRevision],
+  );
+  const baseFlows = useMemo(
+    () => revisionSnapshot(architecture.flows, viewRevision, currentRevision),
+    [architecture.flows, currentRevision, viewRevision],
+  );
+  const baseFlowSteps = useMemo(
+    () => revisionSnapshot(architecture.flowSteps, viewRevision, currentRevision),
+    [architecture.flowSteps, currentRevision, viewRevision],
+  );
+  const pendingEntities = useMemo(() => architecture.entities.filter((entity) => entity.lifecycleStatus === "PENDING"), [architecture.entities]);
+  const pendingRelations = useMemo(() => architecture.relations.filter((relation) => relation.lifecycleStatus === "PENDING"), [architecture.relations]);
+  const pendingFlows = useMemo(() => architecture.flows.filter((flow) => flow.lifecycleStatus === "PENDING"), [architecture.flows]);
+  const pendingFlowSteps = useMemo(() => architecture.flowSteps.filter((step) => step.lifecycleStatus === "PENDING"), [architecture.flowSteps]);
+  const showChangeOverlay = showPending && isCurrentRevision;
+  const entities = useMemo(() => latestModel(baseEntities, pendingEntities, (entity) => entity.entityKey, showChangeOverlay), [baseEntities, pendingEntities, showChangeOverlay]);
+  const relations = useMemo(() => latestModel(baseRelations, pendingRelations, (relation) => relation.relationKey, showChangeOverlay), [baseRelations, pendingRelations, showChangeOverlay]);
+  const flows = useMemo(() => latestModel(baseFlows, pendingFlows, (flow) => flow.flowKey, showChangeOverlay), [baseFlows, pendingFlows, showChangeOverlay]);
+  const flowSteps = useMemo(() => latestModel(baseFlowSteps, pendingFlowSteps, (step) => `${step.flowKey}:${step.stepKey}`, showChangeOverlay), [baseFlowSteps, pendingFlowSteps, showChangeOverlay]);
+
+  const previousRevision = useMemo(() => {
+    const index = revisionOptions.indexOf(viewRevision) - 1;
+    return index >= 0 ? revisionOptions[index] : null;
+  }, [revisionOptions, viewRevision]);
+  const timelineStates = useMemo(() => {
+    const states = new Map<string, "added" | "changed">();
+    if (previousRevision === null || graphOverride) return states;
+    const previous = new Map(atRevision(architecture.entities.filter((entity) => entity.lifecycleStatus !== "PENDING"), previousRevision).map((entity) => [entity.entityKey, entity]));
+    for (const entity of entities) {
+      const prior = previous.get(entity.entityKey);
+      if (!prior) states.set(entity.entityKey, "added");
+      else if (!sameEntity(prior, entity)) states.set(entity.entityKey, "changed");
+    }
+    return states;
+  }, [architecture.entities, entities, graphOverride, previousRevision]);
+
+  const graph = useMemo(() => graphOverride ?? adaptArchitectureToSemanticGraph({
+    projectId: detail?.project.id ?? "fixture",
+    projectName: detail?.project.name ?? "Canvas Fixture",
+    revision: viewRevision,
+    entities,
+    relations,
+    flows,
+    flowSteps,
+    timelineStates,
+  }), [detail?.project.id, detail?.project.name, entities, flowSteps, flows, graphOverride, relations, timelineStates, viewRevision]);
+  const fingerprint = useMemo(() => semanticGraphFingerprint(graph), [graph]);
+  const storageKey = useMemo(() => layoutStorageKey(graph), [graph]);
+  const view = useMemo(() => deriveCanvasView(graph, interaction), [graph, interaction]);
+  const inspectorBinding = useMemo(() => bindInspector(graph, interaction.selection), [graph, interaction.selection]);
+  const projection = useMemo(() => layout ? projectSemanticGraph(graph, layout, view) : { nodes: [], edges: [] }, [graph, layout, view]);
+  const searchResults = useMemo(() => interaction.searchQuery.trim()
+    ? graph.objects.filter((object) => view.searchMatches.has(object.id)).slice(0, 8)
+    : [], [graph.objects, interaction.searchQuery, view.searchMatches]);
+  const neighborNames = useMemo(() => Object.fromEntries(graph.objects.map((object) => [object.id, object.name])), [graph.objects]);
+
+  const fitCanvas = useCallback((state: Pick<CanvasInteractionState, "mode" | "selection" | "activeFlowId">, duration = 360) => {
+    const instance = instanceRef.current;
+    if (!instance) return;
+    const targetObjectIds = new Set<string>();
+    if (state.mode === "trace" && state.activeFlowId) {
+      const flow = graph.flows.find((candidate) => candidate.id === state.activeFlowId);
+      for (const objectId of flow?.objectIds ?? []) targetObjectIds.add(objectId);
+    } else if ((state.mode === "focus" || state.mode === "inspect") && (state.selection?.kind === "object" || state.selection?.kind === "objects")) {
+      const selectedIds = state.selection.kind === "object" ? [state.selection.id] : state.selection.ids;
+      for (const selectedId of selectedIds) {
+        targetObjectIds.add(selectedId);
+        for (const relationship of graph.relationships) {
+          if (relationship.sourceObjectId === selectedId) targetObjectIds.add(relationship.targetObjectId);
+          if (relationship.targetObjectId === selectedId) targetObjectIds.add(relationship.sourceObjectId);
+        }
+      }
+    } else if (state.mode === "inspect" && state.selection?.kind === "relationship") {
+      const relationshipId = state.selection.id;
+      const relationship = graph.relationships.find((candidate) => candidate.id === relationshipId);
+      if (relationship) {
+        targetObjectIds.add(relationship.sourceObjectId);
+        targetObjectIds.add(relationship.targetObjectId);
+      }
+    }
+    const allNodes = instance.getNodes();
+    const targetNodes = targetObjectIds.size > 0
+      ? allNodes.filter((node) => targetObjectIds.has(node.id))
+      : allNodes;
+    if (targetNodes.length === 0) return;
+    void instance.fitView({
+      ...canvasFitOptions(state.mode, duration),
+      nodes: targetNodes,
+    });
+  }, [graph.flows, graph.relationships]);
+
+  useEffect(() => {
+    if (!playingTimeline) return;
+    const timer = window.setInterval(() => {
+      setRevisionIndex((index) => {
+        if (index >= revisionOptions.length - 1) {
+          setPlayingTimeline(false);
+          return index;
+        }
+        return index + 1;
+      });
+    }, 1300);
+    return () => window.clearInterval(timer);
+  }, [playingTimeline, revisionOptions.length]);
+
+  useEffect(() => {
+    let cancelled = false;
+    const cacheKey = `${storageKey}:${fingerprint}`;
+    const cached = layoutReset === 0 ? layoutMemory.get(cacheKey) ?? readLayout(storageKey, fingerprint) : null;
+    if (cached) {
+      previousLayoutRef.current = cached;
+      const timer = window.setTimeout(() => {
+        setLayout(cached);
+        setLayouting(false);
+        setLayoutError("");
+      }, 0);
+      return () => window.clearTimeout(timer);
+    }
+    const loadingTimer = window.setTimeout(() => setLayouting(true), 0);
+    void layoutSemanticGraph(graph, { previousLayout: previousLayoutRef.current ?? undefined })
+      .then((nextLayout) => {
+        if (cancelled) return;
+        previousLayoutRef.current = nextLayout;
+        writeLayout(storageKey, nextLayout);
+        setLayout(nextLayout);
+        setLayoutError("");
+        setLayouting(false);
+      })
+      .catch(() => {
+        if (cancelled) return;
+        setLayout(previousLayoutRef.current);
+        setLayoutError("ELK could not arrange this graph. The last stable local layout is preserved.");
+        setLayouting(false);
+      });
+    return () => { cancelled = true; window.clearTimeout(loadingTimer); };
+  }, [fingerprint, graph, layoutReset, storageKey]);
+
+  useEffect(() => {
+    setNodes(projection.nodes);
+    setEdges(projection.edges);
+    const layoutIdentity = layout ? `${storageKey}:${layout.fingerprint}` : "";
+    if (layoutIdentity && fittedLayoutRef.current !== layoutIdentity) {
+      fittedLayoutRef.current = layoutIdentity;
+      const timer = window.setTimeout(() => fitCanvas(interaction, 420), 70);
+      return () => window.clearTimeout(timer);
+    }
+    return undefined;
+  }, [fitCanvas, interaction, layout, projection, setEdges, setNodes, storageKey]);
+
+  useEffect(() => {
+    if (!layout) return undefined;
+    const selectionKey = interaction.selection
+      ? `${interaction.selection.kind}:${interaction.selection.kind === "objects" ? interaction.selection.ids.slice().sort().join(",") : interaction.selection.id}`
+      : "none";
+    const cameraIntent = `${layout.fingerprint}:${interaction.mode}:${interaction.activeFlowId ?? "none"}:${selectionKey}:${inspectorBinding ? "docked" : "open"}`;
+    if (cameraIntentRef.current === cameraIntent) return undefined;
+    cameraIntentRef.current = cameraIntent;
+    const timer = window.setTimeout(() => fitCanvas(interaction, 360), 70);
+    return () => window.clearTimeout(timer);
+  }, [fitCanvas, inspectorBinding, interaction, layout]);
+
+  useEffect(() => {
+    const availableObjects = new Set(graph.objects.map((object) => object.id));
+    const availableRelationships = new Set(graph.relationships.map((relationship) => relationship.id));
+    const availableFlows = new Set(graph.flows.map((flow) => flow.id));
+    const selection = interaction.selection;
+    const valid = !selection
+      || (selection.kind === "object" && availableObjects.has(selection.id))
+      || (selection.kind === "objects" && selection.ids.length > 0 && selection.ids.every((id) => availableObjects.has(id)))
+      || (selection.kind === "relationship" && availableRelationships.has(selection.id))
+      || (selection.kind === "flow" && availableFlows.has(selection.id));
+    if (!valid || (interaction.activeFlowId && !availableFlows.has(interaction.activeFlowId))) {
+      const timer = window.setTimeout(() => setInteraction((current) => ({ ...current, mode: "browse", selection: null, activeFlowId: null })), 0);
+      return () => window.clearTimeout(timer);
+    }
+    return undefined;
+  }, [graph, interaction.activeFlowId, interaction.selection]);
+
+  function applySelection(current: CanvasInteractionState, selection: CanvasSelection): CanvasInteractionState {
+    if (!selection) return { ...current, mode: "browse", selection: null, activeFlowId: null };
+    if (selection.kind === "flow") return { ...current, mode: "trace", selection, activeFlowId: selection.id };
+    if (current.mode === "trace") return { ...current, selection };
+    if (current.mode === "focus" && selection.kind === "object") return { ...current, selection, activeFlowId: null };
+    return { ...current, mode: "inspect", selection, activeFlowId: null };
+  }
+
+  const select = useCallback((selection: CanvasSelection) => {
+    setInteraction((current) => applySelection(current, selection));
+  }, []);
+
+  // React Flow native multi-selection (marquee/box drag, modifier clicks) feeds the same
+  // interaction state: one object keeps the established single-select path, several objects
+  // become a multi-selection with union impact, an empty selection returns to idle Browse.
+  const handleSelectionChange = useCallback((objectIds: string[]) => {
+    setInteraction((current) => {
+      const next = [...new Set(objectIds)].sort();
+      const currentIds = current.selection?.kind === "object"
+        ? [current.selection.id]
+        : current.selection?.kind === "objects"
+          ? [...current.selection.ids].sort()
+          : null;
+      if (currentIds && currentIds.join("␀") === next.join(" ")) return current;
+      if (next.length === 0) {
+        // Relationship and Flow selections own their own click paths; an empty node
+        // selection only clears object selections.
+        if (!current.selection || (current.selection.kind !== "object" && current.selection.kind !== "objects")) return current;
+        return current.mode === "trace"
+          ? { ...current, selection: null }
+          : { ...current, mode: "browse", selection: null, activeFlowId: null };
+      }
+      if (next.length === 1) return applySelection(current, { kind: "object", id: next[0] });
+      return current.mode === "trace"
+        ? { ...current, selection: { kind: "objects", ids: next } }
+        : { ...current, mode: "inspect", selection: { kind: "objects", ids: next }, activeFlowId: null };
+    });
+  }, []);
+
+  // React Flow reports user-driven selection (plain click, modifier click, marquee drag)
+  // through node "select" changes. Routing them through the same interaction state keeps the
+  // projection the single source of truth; subscribing to onSelectionChange instead would
+  // fight the controlled nodes replacement (verified: state ping-pong and update-depth crash).
+  const handleNodesChange = useCallback((changes: NodeChange<CanvasNode>[]) => {
+    const selectionChanges = changes.filter((change): change is NodeSelectionChange => change.type === "select");
+    if (selectionChanges.length > 0) {
+      const toggled = new Map(selectionChanges.map((change) => [change.id, change.selected]));
+      const nextObjectIds: string[] = [];
+      for (const node of nodes) {
+        if (node.type !== "object") continue;
+        const isSelected = toggled.get(node.id) ?? node.selected;
+        if (isSelected) nextObjectIds.push(node.id);
+      }
+      handleSelectionChange(nextObjectIds);
+    }
+    onNodesChange(changes);
+  }, [handleSelectionChange, nodes, onNodesChange]);
+
+  const focusObject = useCallback((objectId: string) => {
+    setInteraction((current) => ({ ...current, mode: "focus", selection: { kind: "object", id: objectId }, activeFlowId: null }));
+  }, []);
+
+  useEffect(() => {
+    const onKeyDown = (event: KeyboardEvent) => {
+      const target = event.target as HTMLElement | null;
+      if (target?.matches("input, textarea, select, [contenteditable='true']")) return;
+      if (event.key.toLowerCase() === "f" && interaction.selection?.kind === "object") focusObject(interaction.selection.id);
+      if (event.key === "Escape") select(null);
+    };
+    window.addEventListener("keydown", onKeyDown);
+    return () => window.removeEventListener("keydown", onKeyDown);
+  }, [focusObject, interaction.selection, select]);
+
+  function handleNodeDragStop(node: CanvasObjectNode) {
+    if (!layout) return;
+    const previousRect = layout.objectRects[node.id];
+    if (!previousRect) return;
+    const incidentRelationshipIds = new Set(graph.relationships
+      .filter((relationship) => relationship.sourceObjectId === node.id || relationship.targetObjectId === node.id)
+      .map((relationship) => relationship.id));
+    const nextLayout: CanvasLayout = {
+      ...layout,
+      objectRects: { ...layout.objectRects, [node.id]: { ...previousRect, x: node.position.x, y: node.position.y } },
+      relationshipRoutes: Object.fromEntries(Object.entries(layout.relationshipRoutes).filter(([id]) => !incidentRelationshipIds.has(id))),
+    };
+    previousLayoutRef.current = nextLayout;
+    writeLayout(storageKey, nextLayout);
+    setLayout(nextLayout);
+  }
+
+  function resetLayout() {
+    try { window.localStorage.removeItem(storageKey); } catch { /* no-op */ }
+    layoutMemory.delete(`${storageKey}:${fingerprint}`);
+    previousLayoutRef.current = null;
+    fittedLayoutRef.current = "";
+    cameraIntentRef.current = "";
+    setLayoutReset((value) => value + 1);
+  }
+
+  function handlePaneClick() {
+    if (interaction.mode === "trace") setInteraction((current) => ({ ...current, selection: null }));
+    else select(null);
+  }
+
+  async function toggleFullscreen() {
+    if (!document.fullscreenElement) await canvasRef.current?.requestFullscreen();
+    else await document.exitFullscreen();
+  }
+
+  if (!graphOverride && isCurrentRevision && baseEntities.length === 0 && !showPending) {
+    return (
+      <section className="architecture-empty-state">
+        <small>Architecture Model 尚未建立</small>
+        <h2>这个 Project 还没有可发布的架构对象</h2>
+        <p>Human Web 不负责画图。维护 Agent 应通过 revision-pinned Change 提交 Architecture Observation、Evidence 和关系模型。</p>
+        {pendingEntities.length > 0 && <button onClick={() => setShowPending(true)} type="button">预览 {pendingEntities.length} 个待发布对象</button>}
+        {detail && <Link href={`/maintenance?project=${encodeURIComponent(detail.project.id)}&tab=facts`}>查看 Project Registry</Link>}
+      </section>
+    );
+  }
+
+  return (
+    <div className="architecture-workbench" ref={canvasRef}>
+      <header className="canvas-commandbar">
+        <nav className="canvas-modes" aria-label="Canvas mode">
+          <button className={interaction.mode === "browse" ? "active" : ""} onClick={() => select(null)} type="button">Browse</button>
+          <button className={interaction.mode === "inspect" ? "active" : ""} disabled={!interaction.selection || interaction.selection.kind === "flow"} onClick={() => setInteraction((current) => ({ ...current, mode: "inspect", activeFlowId: null }))} type="button">Inspect</button>
+          <button className={interaction.mode === "focus" ? "active" : ""} disabled={interaction.selection?.kind !== "object"} onClick={() => interaction.selection?.kind === "object" && focusObject(interaction.selection.id)} type="button">Focus</button>
+          <button className={interaction.mode === "trace" ? "active" : ""} onClick={() => setFlowLensOpen((open) => !open)} type="button">Trace <b>{graph.flows.length}</b></button>
+        </nav>
+        <div className="canvas-search">
+          <input aria-label="Search architecture objects" onChange={(event) => setInteraction((current) => ({ ...current, searchQuery: event.target.value }))} placeholder="Search objects…" value={interaction.searchQuery} />
+          {searchResults.length > 0 && (
+            <div className="canvas-search-results">
+              {searchResults.map((object) => <button key={object.id} onClick={() => { select({ kind: "object", id: object.id }); setInteraction((current) => ({ ...current, searchQuery: "" })); }} type="button"><span>{object.objectType}</span><strong>{object.name}</strong></button>)}
+            </div>
+          )}
+        </div>
+        <div className="canvas-command-actions">
+          {detail && isCurrentRevision && pendingEntities.length > 0 && <button className={showPending ? "active" : ""} onClick={() => setShowPending((value) => !value)} type="button">Change Overlay <b>{pendingEntities.length}</b></button>}
+          <button onClick={() => fitCanvas(interaction, 300)} type="button">Fit</button>
+          <button onClick={resetLayout} type="button">Layout</button>
+          <button onClick={() => void toggleFullscreen()} type="button">Full</button>
+        </div>
+      </header>
+
+      {detail && revisionOptions.length > 1 && (
+        <div className="revision-timeline">
+          <button aria-label={playingTimeline ? "暂停 Revision Timeline" : "播放 Revision Timeline"} onClick={() => {
+            if (revisionIndex >= revisionOptions.length - 1) setRevisionIndex(0);
+            setPlayingTimeline((playing) => !playing);
+            select(null);
+          }} type="button">{playingTimeline ? "Pause" : "Play"}</button>
+          <small>Architecture Timeline</small>
+          <input aria-label="选择 Project Revision" max={revisionOptions.length - 1} min="0" onChange={(event) => { setPlayingTimeline(false); setShowPending(false); select(null); setRevisionIndex(Number(event.target.value)); }} step="1" type="range" value={revisionIndex} />
+          <strong>r{viewRevision}</strong>
+          <span>{isCurrentRevision ? "Current" : "Snapshot"}</span>
+        </div>
+      )}
+
+      <div className={`canvas-stage ${inspectorBinding ? "has-inspector" : ""}`}>
+        <div className="canvas-viewport">
+          <ArchitectureCanvasKernel
+            edges={edges}
+            mode={interaction.mode}
+            nodes={nodes}
+            onEdgeClick={(edge) => select({ kind: "relationship", id: edge.id })}
+            onEdgesChange={onEdgesChange}
+            onInit={(instance) => { instanceRef.current = instance; }}
+            onNodeClick={(node) => select({ kind: "object", id: node.id })}
+            onNodeDragStop={handleNodeDragStop}
+            onNodesChange={onNodesChange}
+            onPaneClick={handlePaneClick}
+            onNodesChange={handleNodesChange}
+            onViewportChange={(viewport) => setInteraction((current) => Math.abs(current.zoom - viewport.zoom) < 0.015 ? current : { ...current, zoom: viewport.zoom })}
+          >
+            <div className="canvas-reading-key">
+              <span><i className="object-key" /> Object</span>
+              <span><i className="relationship-key" /> Relationship</span>
+              {view.impact && <span><i aria-hidden="true" className="impact-key impact-upstream">↑</i> Upstream</span>}
+              {view.impact && <span><i aria-hidden="true" className="impact-key impact-downstream">↓</i> Downstream</span>}
+              {view.impact && view.impact.sharedObjectIds.size > 0 && <span><i aria-hidden="true" className="impact-key impact-shared">⇄</i> Shared</span>}
+              {interaction.mode === "trace" && <span><i className="trace-key" /> Active Flow</span>}
+              <em>{interaction.mode === "trace" ? "动画表示语义顺序，不代表实时流量" : view.impact ? "↑ 依赖来源 · ↓ 依赖方 · ⇄ 多个所选对象的共同影响 · 箭头指向数据/控制流向" : "拖动空白框选对象 · 右键/中键拖动平移 · 拖动只调整本机视图，不改变架构关系"}</em>
+            </div>
+          </ArchitectureCanvasKernel>
