+test("multi-select computes the union of impact and marks shared impact", () => {
+  const graph = SMALL_CANVAS_FIXTURE;
+  const index = indexSemanticGraph(graph);
+  const roots = [graph.objects[0].id, graph.objects[3].id];
+
+  const aggregate = deriveAggregateImpact(graph, index, roots);
+  const expectedUpstream = new Map();
+  const expectedDownstream = new Map();
+  const expectedCounts = new Map();
+  for (const rootId of roots) {
+    for (const [id, depth] of reachableDepths(graph, rootId, "upstream")) {
+      const known = expectedUpstream.get(id);
+      if (known === undefined || depth < known) expectedUpstream.set(id, depth);
+      expectedCounts.set(id, (expectedCounts.get(id) ?? 0) + 1);
+    }
+    for (const [id, depth] of reachableDepths(graph, rootId, "downstream")) {
+      const known = expectedDownstream.get(id);
+      if (known === undefined || depth < known) expectedDownstream.set(id, depth);
+      expectedCounts.set(id, (expectedCounts.get(id) ?? 0) + 1);
+    }
+  }
+  assert.deepEqual(mapToObject(aggregate.upstream), mapToObject(expectedUpstream), "union upstream must keep the minimum hop depth across roots");
+  assert.deepEqual(mapToObject(aggregate.downstream), mapToObject(expectedDownstream), "union downstream must keep the minimum hop depth across roots");
+  assert.deepEqual(mapToObject(aggregate.objectImpactCounts), mapToObject(expectedCounts));
+  const expectedShared = [...expectedCounts].filter(([, count]) => count > 1).map(([id]) => id);
+  assert.ok(expectedShared.length > 0, "fixture roots must produce shared impact to assert on");
+  assert.deepEqual([...aggregate.sharedObjectIds].sort(), [...new Set(expectedShared)].sort());
+  assert.deepEqual([...aggregate.rootIds], roots);
+  for (const [id, count] of aggregate.objectImpactCounts) {
+    assert.equal(aggregate.sharedObjectIds.has(id), count > 1, `shared flag for ${id} must match its impact count`);
+  }
+  for (const [id, role] of aggregate.objectRoles) {
+    const upstream = aggregate.upstream.has(id);
+    const downstream = aggregate.downstream.has(id);
+    assert.equal(role, upstream && downstream ? "both" : upstream ? "upstream" : "downstream");
+  }
+  assert.ok(aggregate.relationshipRoles.size > 0, "union impact must classify relationships");
+  for (const [id, count] of aggregate.relationshipImpactCounts) {
+    assert.ok(count >= 1 && count <= roots.length);
+    assert.ok(aggregate.relationshipRoles.has(id));
+  }
+});
