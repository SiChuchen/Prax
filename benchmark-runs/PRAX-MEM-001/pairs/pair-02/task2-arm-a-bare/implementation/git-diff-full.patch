+    push(incoming, relationship.targetObjectId, relationship.sourceObjectId);
+    if (relationship.direction === "bidirectional") {
+      push(outgoing, relationship.targetObjectId, relationship.sourceObjectId);
+      push(incoming, relationship.sourceObjectId, relationship.targetObjectId);
+    }
+  }
+  return { outgoing, incoming };
+}
+
+function reachableDepths(graph, rootId, side) {
+  const { outgoing, incoming } = adjacency(graph);
+  const depths = new Map();
+  const queue = [[rootId, 0]];
+  while (queue.length > 0) {
+    const [id, depth] = queue.shift();
+    for (const nextId of (side === "upstream" ? incoming : outgoing).get(id) ?? []) {
+      if (nextId === rootId) continue;
+      const nextDepth = depth + 1;
+      const known = depths.get(nextId);
+      if (known !== undefined && known <= nextDepth) continue;
+      depths.set(nextId, nextDepth);
+      queue.push([nextId, nextDepth]);
+    }
+  }
+  return depths;
+}
+
+function mapToObject(map) {
+  return Object.fromEntries([...map.entries()].sort((left, right) => left[0].localeCompare(right[0])));
+}
