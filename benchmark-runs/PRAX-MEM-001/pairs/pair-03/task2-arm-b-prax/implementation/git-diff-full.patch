+
+function aggregateExpectation(graph, selectedIds) {
+  const touchedBy = new Map();
+  const relationshipSelectedHits = new Map();
+  for (const selectedId of selectedIds) {
+    for (const relationship of graph.relationships) {
+      const selectedIsTarget = relationship.targetObjectId === selectedId;
+      const selectedIsSource = relationship.sourceObjectId === selectedId;
+      if (!selectedIsTarget && !selectedIsSource) continue;
+      const neighborId = selectedIsTarget ? relationship.sourceObjectId : relationship.targetObjectId;
+      if (neighborId === selectedId) continue;
+      const role = selectedIsTarget ? "upstream" : "downstream";
+      const entry = touchedBy.get(neighborId) ?? new Map();
+      const roles = entry.get(selectedId) ?? new Set();
+      roles.add(role);
+      entry.set(selectedId, roles);
+      touchedBy.set(neighborId, entry);
+      const relationshipEntry = relationshipSelectedHits.get(relationship.id) ?? new Set();
+      relationshipEntry.add(selectedId);
+      relationshipSelectedHits.set(relationship.id, relationshipEntry);
+    }
+  }
+  const selectedSet = new Set(selectedIds);
+  const upstream = [];
+  const downstream = [];
+  const shared = [];
+  for (const [objectId, perSelected] of touchedBy) {
+    if (selectedSet.has(objectId)) continue;
+    if ([...perSelected.values()].some((roles) => roles.has("upstream"))) upstream.push(objectId);
+    if ([...perSelected.values()].some((roles) => roles.has("downstream"))) downstream.push(objectId);
+    if (perSelected.size >= 2) shared.push(objectId);
+  }
+  const sharedSet = new Set(shared);
+  const sharedRelationships = [...relationshipSelectedHits.entries()].filter(([, hits]) => hits.size >= 2).map(([id]) => id);
+  return {
+    upstream: upstream.sort(),
+    downstream: downstream.sort(),
+    shared: shared.sort(),
+    nonSharedUpstream: upstream.filter((id) => !sharedSet.has(id)).sort(),
+    nonSharedDownstream: downstream.filter((id) => !sharedSet.has(id)).sort(),
+    sharedRelationships: sharedRelationships.sort(),
+    touchedBy,
+    selectedSet,
+  };
+}
+
+function pickMixedSelection(graph, minUpstream = 1, minDownstream = 1) {
+  const ids = graph.objects.map((object) => object.id);
+  for (let a = 0; a < ids.length; a += 1) {
+    for (let b = a + 1; b < ids.length; b += 1) {
+      for (let c = b + 1; c < ids.length; c += 1) {
+        const selection = [ids[a], ids[b], ids[c]];
+        const expectation = aggregateExpectation(graph, selection);
+        if (expectation.nonSharedUpstream.length >= minUpstream && expectation.nonSharedDownstream.length >= minDownstream && expectation.shared.length >= 1) {
+          return { selection, expectation };
+        }
+      }
+    }
+  }
+  throw new Error("fixture has no mixed-role selection");
+}
