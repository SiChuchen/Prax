+  for (const relationship of MEDIUM_CANVAS_FIXTURE.relationships) assert.equal(browse.relationshipEmphasis.get(relationship.id), "normal", "Deselect must return every relationship to normal");
+
+  const focus = deriveCanvasView(MEDIUM_CANVAS_FIXTURE, {
