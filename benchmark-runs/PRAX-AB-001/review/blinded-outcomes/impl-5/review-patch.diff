+"use client";
+
+import { useEffect, useRef, type Ref } from "react";
+import type { CanvasSelection, TraceCorridor } from "./interaction";
+
+// The ordered main path of the active Flow: entry step, hand-offs, outcome
+// step. The strip carries the full order; the canvas underneath stays a stable
+// readable map that the camera follows step by step.
+export default function TraceCorridor({
+  corridor,
+  selectedObjectId,
+  onSelect,
+  ref,
+}: {
+  corridor: TraceCorridor;
+  selectedObjectId: string | null;
+  onSelect: (selection: CanvasSelection) => void;
+  ref?: Ref<HTMLElement>;
+}) {
+  const currentRef = useRef<HTMLLIElement | null>(null);
+  const steps = corridor.steps;
+
+  useEffect(() => {
+    currentRef.current?.scrollIntoView({ block: "nearest", inline: "nearest" });
+  }, [selectedObjectId]);
+
+  return (
+    <aside aria-label={`Trace 走廊 ${corridor.flow.name}`} className="trace-corridor" ref={ref}>
+      <header>
+        <div>
+          <small>Trace Corridor</small>
+          <strong>{corridor.flow.name}</strong>
+        </div>
+        <span>
+          {corridor.flow.metadata.trigger ? `${corridor.flow.metadata.trigger} → ` : ""}
+          {corridor.flow.metadata.outcome ?? ""}
+        </span>
+      </header>
+      <ol className="trace-corridor-rail">
+        {steps.map((entry, index) => {
+          const next = steps[index + 1];
+          const transition = next
+            ? corridor.transitions.find((candidate) => candidate.fromStepId === entry.step.id && candidate.toStepId === next.step.id)
+            : undefined;
+          const current = entry.step.objectId === selectedObjectId;
+          return (
+            <li className={current ? "current" : ""} key={entry.step.id} ref={current ? currentRef : undefined}>
+              <button
+                onClick={() => onSelect({ kind: "object", id: entry.step.objectId })}
+                title={`${entry.step.role} · ${entry.step.action || entry.step.title}${transition ? ` · ${transition.payload}` : ""}`}
+                type="button"
+              >
+                <b>{entry.step.sequence}</b>
+                <span>
+                  <em>{entry.isEntry ? "入口 · entry" : entry.isExit ? "结果 · exit" : entry.step.role}</em>
+                  <strong>{entry.step.title}</strong>
+                  <small>{entry.object?.name ?? entry.step.objectId}</small>
+                </span>
+              </button>
+              {next && <i className="trace-transition" title={transition?.payload}>→</i>}
+            </li>
+          );
+        })}
+      </ol>
+    </aside>
+  );
+}
