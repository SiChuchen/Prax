new file mode 100644
index 0000000..425e9b1
--- /dev/null
+++ b/app/architecture/camera.ts
@@ -0,0 +1,97 @@
+import type { CanvasLayout, LayoutRect } from "./layout";
+import type { SemanticGraph } from "./semantic-graph";
+
+// The default camera never opens below the architecture band: a fit that would
+// crush labels into a thumbnail is clamped, and the map is allowed to overflow
+// the viewport instead ("most of the viewport is content" — not "all geometry
+// fits at once"). The floor sits inside the band so the opening view also
+// shows Region summaries.
+export const ARCHITECTURE_ZOOM_FLOOR = 0.8;
+export const DEFAULT_FIT_PADDING = 0.14;
+export const DEFAULT_FIT_MAX_ZOOM = 1.05;
+export const INSPECTOR_WIDTH = 336;
+
+export type CameraViewport = { x: number; y: number; zoom: number };
+
+export type CameraBounds = { x: number; y: number; width: number; height: number };
+
+export type ViewportSize = { width: number; height: number };
+
+export function rectBounds(rects: LayoutRect[]): CameraBounds | null {
+  if (rects.length === 0) return null;
+  const minX = Math.min(...rects.map((rect) => rect.x));
+  const minY = Math.min(...rects.map((rect) => rect.y));
+  const maxX = Math.max(...rects.map((rect) => rect.x + rect.width));
+  const maxY = Math.max(...rects.map((rect) => rect.y + rect.height));
+  return { x: minX, y: minY, width: maxX - minX, height: maxY - minY };
+}
+
+export function topLevelRegionBounds(layout: CanvasLayout): CameraBounds | null {
+  const rects = Object.values(layout.regionRects);
+  const topLevel = rects.filter((rect) => !rect.parentRegionId);
+  return rectBounds(topLevel.length > 0 ? topLevel : rects);
+}
+
+export function primaryRegionRect(graph: SemanticGraph, layout: CanvasLayout) {
+  const topRegions = graph.regions
+    .filter((region) => !region.parentRegionId)
+    .sort((left, right) => right.importance.score - left.importance.score || (left.order ?? 0) - (right.order ?? 0));
+  return layout.regionRects[topRegions[0]?.id ?? ""] ?? null;
+}
+
+// When the map overflows the viewport, anchor the opening camera near the
+// primary Region's top so its header and summary enter the first screen
+// instead of being centered away off-canvas.
+export function primaryRegionAnchor(
+  graph: SemanticGraph,
+  layout: CanvasLayout,
+  zoom: number,
+  viewport: ViewportSize,
+): { x: number; y: number } | undefined {
+  const rect = primaryRegionRect(graph, layout);
+  if (!rect) return undefined;
+  return {
+    x: rect.x + viewport.width * 0.35 / zoom,
+    y: rect.y + viewport.height * 0.4 / zoom,
+  };
+}
+
+export function resolveFitZoom(
+  bounds: CameraBounds,
+  viewport: ViewportSize,
+  options: { padding?: number; zoomFloor?: number; maxZoom?: number } = {},
+) {
+  const padding = options.padding ?? DEFAULT_FIT_PADDING;
+  const zoomFloor = options.zoomFloor ?? ARCHITECTURE_ZOOM_FLOOR;
+  const maxZoom = options.maxZoom ?? DEFAULT_FIT_MAX_ZOOM;
+  const available = 1 - padding * 2;
+  const fit = Math.min(viewport.width * available / Math.max(bounds.width, 1), viewport.height * available / Math.max(bounds.height, 1));
+  return Math.min(maxZoom, Math.max(zoomFloor, fit));
+}
+
+export function defaultViewport(
+  bounds: CameraBounds,
+  viewport: ViewportSize,
+  options: { padding?: number; zoomFloor?: number; maxZoom?: number; focus?: { x: number; y: number } } = {},
+): CameraViewport {
+  const zoom = resolveFitZoom(bounds, viewport, options);
+  const center = options.focus ?? { x: bounds.x + bounds.width / 2, y: bounds.y + bounds.height / 2 };
+  return { x: viewport.width / 2 - zoom * center.x, y: viewport.height / 2 - zoom * center.y, zoom };
+}
+
+// Docked workspace chrome (Inspector on the right, Trace corridor at the
+// bottom) shrinks the effective viewport. The camera answers with a pan, never
+// a zoom-out: Browse density must survive docking.
+export function dockViewportShift(viewport: CameraViewport, delta: { right?: number; bottom?: number }): CameraViewport {
+  return {
+    ...viewport,
+    x: viewport.x - (delta.right ?? 0) / 2,
+    y: viewport.y - (delta.bottom ?? 0) / 2,
+  };
+}
+
+export function viewportCoverage(bounds: CameraBounds, viewport: ViewportSize, camera: CameraViewport) {
+  const coveredWidth = Math.min(1, bounds.width * camera.zoom / viewport.width);
+  const coveredHeight = Math.min(1, bounds.height * camera.zoom / viewport.height);
+  return { width: coveredWidth, height: coveredHeight, area: coveredWidth * coveredHeight };
+}
