diff --git a/tests/canvas-readability.test.mjs b/tests/canvas-readability.test.mjs
new file mode 100644
index 0000000..97f7010
--- /dev/null
+++ b/tests/canvas-readability.test.mjs
@@ -0,0 +1,189 @@
+import assert from "node:assert/strict";
+import { register } from "node:module";
+import test from "node:test";
+
+register("./cloudflare-loader.mjs", import.meta.url);
+
+const { CANVAS_FIXTURES, MEDIUM_CANVAS_FIXTURE, SMALL_CANVAS_FIXTURE } = await import("../app/architecture/fixtures.ts");
+const {
+  ARCHITECTURE_ZOOM_FLOOR,
+  defaultViewport,
+  dockViewportShift,
+  INSPECTOR_WIDTH,
+  topLevelRegionBounds,
+  viewportCoverage,
+} = await import("../app/architecture/camera.ts");
+const {
+  deriveCanvasView,
+  deriveTraceCorridor,
+  readableLabelScale,
+  semanticZoomLevel,
+} = await import("../app/architecture/interaction.ts");
+const { layoutSemanticGraph } = await import("../app/architecture/layout.ts");
+const { projectSemanticGraph, summarizeRegions } = await import("../app/architecture/projection.ts");
+const { indexSemanticGraph } = await import("../app/architecture/semantic-graph.ts");
+
+const DESKTOP_VIEWPORT = { width: 1600, height: 860 };
+
+test("default camera opens at architecture density, never as a thumbnail", async () => {
+  for (const [name, graph] of Object.entries(CANVAS_FIXTURES)) {
+    const layout = await layoutSemanticGraph(graph);
+    const bounds = topLevelRegionBounds(layout);
+    assert.ok(bounds, `${name} needs top-level bounds`);
+    const camera = defaultViewport(bounds, DESKTOP_VIEWPORT);
+    assert.ok(
+      camera.zoom >= ARCHITECTURE_ZOOM_FLOOR,
+      `${name} default zoom ${camera.zoom.toFixed(3)} must stay in the architecture band`,
+    );
+    const coverage = viewportCoverage(bounds, DESKTOP_VIEWPORT, camera);
+    assert.ok(
+      Math.max(coverage.width, coverage.height) >= 0.7,
+      `${name} content must occupy most of the viewport, received ${coverage.width.toFixed(2)}×${coverage.height.toFixed(2)}`,
+    );
+  }
+});
+
+test("zoom floor keeps every visible label above the 13px screen floor", () => {
+  assert.equal(semanticZoomLevel(0.49), "landscape");
+  assert.equal(semanticZoomLevel(0.5), "architecture");
+  assert.equal(semanticZoomLevel(ARCHITECTURE_ZOOM_FLOOR - 0.01), "architecture");
+  assert.equal(semanticZoomLevel(ARCHITECTURE_ZOOM_FLOOR), "architecture", "the default zoom floor must open inside the architecture band");
+  assert.equal(semanticZoomLevel(0.85), "component");
+  assert.equal(semanticZoomLevel(1.24), "component");
+  assert.equal(semanticZoomLevel(1.25), "operational");
+
+  const objectLabelPx = 15;
+  const regionLabelPx = 13;
+  for (const zoom of [0.3, 0.42, 0.5, 0.64, 0.85, 0.95, 1.1]) {
+    const objectScale = readableLabelScale(zoom, objectLabelPx);
+    const regionScale = readableLabelScale(zoom, regionLabelPx);
+    assert.ok(objectLabelPx * zoom * objectScale >= 13, `object label at zoom ${zoom} is ${objectLabelPx * zoom * objectScale}px`);
+    assert.ok(regionLabelPx * zoom * regionScale >= 13, `region label at zoom ${zoom} is ${regionLabelPx * zoom * regionScale}px`);
+  }
+  assert.equal(readableLabelScale(1.4, objectLabelPx), 1, "zoomed-in labels must not be inflated");
+});
+
+test("top-level Regions compose two-dimensionally instead of one long strip", async () => {
+  for (const name of ["medium", "large", "complex"]) {
+    const graph = CANVAS_FIXTURES[name];
+    const layout = await layoutSemanticGraph(graph);
+    const index = indexSemanticGraph(graph);
+    for (const region of graph.regions) {
+      const children = index.childRegionsByRegionId.get(region.id) ?? [];
+      if (children.length < 3) continue;
+      const rows = new Set(children.map((child) => Math.round((layout.regionRects[child.id]?.y ?? 0) / 80)));
+      assert.ok(rows.size >= 2, `${name}: children of ${region.id} still form a single horizontal strip`);
+    }
+    const bounds = topLevelRegionBounds(layout);
+    assert.ok(
+      bounds.width / bounds.height <= 3.5,
+      `${name} composition aspect ${bounds.width}/${bounds.height} must stay map-like, not a banner`,
+    );
+  }
+});
+
+test("Regions carry a meaningful summary at every density", async () => {
+  const graph = MEDIUM_CANVAS_FIXTURE;
+  const layout = await layoutSemanticGraph(graph);
+  const summaries = summarizeRegions(graph);
+  assert.equal(summaries.size, graph.regions.length);
+  const rootSummary = summaries.get("medium:region:system");
+  assert.equal(rootSummary.objectCount, graph.objects.length, "root summary aggregates the whole subtree");
+  assert.ok(rootSummary.typeCounts.length > 0);
+  assert.ok(rootSummary.crossingRelationships >= 0);
+  assert.ok(rootSummary.keyObjectNames.length <= 3);
+
+  for (const zoomLevel of ["landscape", "architecture"]) {
+    const view = deriveCanvasView(graph, {
+      mode: "browse",
+      selection: null,
+      activeFlowId: null,
+      zoom: zoomLevel === "landscape" ? 0.3 : 0.7,
+      searchQuery: "",
+    });
+    const { nodes } = projectSemanticGraph(graph, layout, view);
+    const regionNodes = nodes.filter((node) => node.type === "region");
+    assert.equal(regionNodes.length, graph.regions.length);
+    for (const node of regionNodes) {
+      assert.ok(node.data.summary.objectCount > 0, `${node.id} summary must describe its contents at ${zoomLevel}`);
+    }
+  }
+
+  const landscape = summaries.get("medium:region:001");
+  const regionObjects = graph.objects.filter((object) => object.regionId === "medium:region:001");
+  assert.ok(landscape.objectCount >= regionObjects.length, "subtree count includes nested regions");
+  const expectedInternal = graph.relationships.filter((relationship) =>
+    regionObjects.some((object) => object.id === relationship.sourceObjectId)
+    && regionObjects.some((object) => object.id === relationship.targetObjectId)).length;
+  assert.ok(landscape.internalRelationships >= expectedInternal);
+});
+
+test("Trace corridor exposes the ordered main path from entry to outcome", () => {
+  const flow = SMALL_CANVAS_FIXTURE.flows[0];
+  const corridor = deriveTraceCorridor(SMALL_CANVAS_FIXTURE, flow.id);
+  assert.ok(corridor, "corridor must resolve for an existing flow");
+  assert.equal(corridor.flow.id, flow.id);
+  const sequences = corridor.steps.map((entry) => entry.step.sequence);
+  assert.deepEqual(sequences, [...sequences].sort((left, right) => left - right), "steps must be ordered by sequence");
+  assert.ok(corridor.steps[0].isEntry, "first step must be marked as the entry");
+  assert.ok(corridor.steps.at(-1).isExit, "last step must be marked as the outcome");
+  assert.equal(corridor.steps[0].step.role, "entry");
+  assert.equal(corridor.steps.at(-1).step.role, "exit");
+  assert.equal(corridor.transitions.length, flow.steps.length - 1, "linear flow transitions match consecutive hand-offs");
+  for (const transition of corridor.transitions) {
+    assert.ok(transition.relationshipId, `transition ${transition.fromStepId}→${transition.toStepId} must ride a relationship`);
+    assert.ok(transition.payload.length > 0, "transitions must name what they carry");
+    assert.equal(transition.toSequence - transition.fromSequence, 1);
+  }
+  assert.equal(deriveTraceCorridor(SMALL_CANVAS_FIXTURE, null), null);
+  assert.equal(deriveTraceCorridor(SMALL_CANVAS_FIXTURE, "missing-flow"), null);
+});
+
+test("Trace keeps the stable map but quiets everything off the corridor", () => {
+  const flow = SMALL_CANVAS_FIXTURE.flows[0];
+  const flowRelationshipIds = new Set(flow.relationshipIds);
+  const flowObjectIds = new Set(flow.objectIds);
+  const view = deriveCanvasView(SMALL_CANVAS_FIXTURE, {
+    mode: "trace",
+    selection: { kind: "flow", id: flow.id },
+    activeFlowId: flow.id,
+    zoom: 0.9,
+    searchQuery: "",
+  });
+  const incidentNonFlow = SMALL_CANVAS_FIXTURE.relationships.find((relationship) =>
+    !flowRelationshipIds.has(relationship.id)
+    && (flowObjectIds.has(relationship.sourceObjectId) || flowObjectIds.has(relationship.targetObjectId)));
+  assert.ok(incidentNonFlow, "fixture must have an incident-but-not-flow relationship");
+  assert.equal(view.relationshipEmphasis.get(incidentNonFlow.id), "muted", "context edges must not compete with the corridor");
+  for (const relationshipId of flowRelationshipIds) {
+    assert.equal(view.relationshipEmphasis.get(relationshipId), "active");
+  }
+  assert.ok([...view.relationshipEmphasis.values()].includes("suppressed"));
+});
+
+test("selecting one relationship makes it followable without losing the map", () => {
+  const relationship = SMALL_CANVAS_FIXTURE.relationships[2];
+  const view = deriveCanvasView(SMALL_CANVAS_FIXTURE, {
+    mode: "inspect",
+    selection: { kind: "relationship", id: relationship.id },
+    activeFlowId: null,
+    zoom: 0.9,
+    searchQuery: "",
+  });
+  assert.equal(view.relationshipEmphasis.get(relationship.id), "active");
+  assert.equal(view.objectEmphasis.get(relationship.sourceObjectId), "primary");
+  assert.equal(view.objectEmphasis.get(relationship.targetObjectId), "primary");
+  const bystander = SMALL_CANVAS_FIXTURE.relationships.find((candidate) => candidate.id !== relationship.id);
+  assert.equal(view.relationshipEmphasis.get(bystander.id), "muted", "other edges must recede, objects stay readable");
+});
+
+test("docked chrome shifts the camera without collapsing zoom", () => {
+  const viewport = { x: 120, y: 60, zoom: 0.9 };
+  const docked = dockViewportShift(viewport, { right: INSPECTOR_WIDTH });
+  assert.equal(docked.zoom, viewport.zoom, "docking must pan, not zoom out");
+  assert.equal(docked.x, viewport.x - INSPECTOR_WIDTH / 2);
+  const undocked = dockViewportShift(docked, { right: -INSPECTOR_WIDTH });
+  assert.deepEqual(undocked, viewport);
+  const corridorDock = dockViewportShift(viewport, { bottom: 96 });
+  assert.equal(corridorDock.y, viewport.y - 48);
+});
