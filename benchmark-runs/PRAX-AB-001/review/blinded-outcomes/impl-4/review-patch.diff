+function packedAncestorRegionId(graph, regionId) {
+  const topLevel = new Set(topLevelRegionIds(graph));
+  const regionById = new Map(graph.regions.map((region) => [region.id, region]));
+  let cursor = regionById.get(regionId);
+  const seen = new Set();
+  while (cursor && !topLevel.has(cursor.id) && cursor.parentRegionId && !seen.has(cursor.id)) {
+    seen.add(cursor.id);
+    cursor = regionById.get(cursor.parentRegionId);
+  }
+  return cursor?.id ?? null;
+}
+
+function crossesTopLevelRegion(graph, relationship) {
+  const regionById = new Map(graph.regions.map((region) => [region.id, region]));
+  const objectById = new Map(graph.objects.map((object) => [object.id, object]));
+  const sourceRegionId = regionById.get(objectById.get(relationship.sourceObjectId)?.regionId ?? "")?.id;
+  const targetRegionId = regionById.get(objectById.get(relationship.targetObjectId)?.regionId ?? "")?.id;
+  return packedAncestorRegionId(graph, sourceRegionId) !== packedAncestorRegionId(graph, targetRegionId);
+}
