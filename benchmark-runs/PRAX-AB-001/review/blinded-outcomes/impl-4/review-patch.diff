+test("Region reading summaries stay meaningful when Landscape hides objects", () => {
+  const topRegions = topLevelRegionIds(MEDIUM_CANVAS_FIXTURE)
+    .map((regionId) => MEDIUM_CANVAS_FIXTURE.regions.find((region) => region.id === regionId))
+    .filter(Boolean);
