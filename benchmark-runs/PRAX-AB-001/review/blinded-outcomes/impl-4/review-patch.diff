+  keyObjectNames: string[];
+};
+
+/**
+ * Landscape hides Objects, so the Region itself must carry a readable summary:
+ * how much lives inside, how connected it is, and which key objects matter.
+ */
+export function regionReadingSummary(graph: SemanticGraph, regionId: string, keyObjectLimit = 3): RegionReadingSummary {
+  const index = indexSemanticGraph(graph);
+  const subtreeRegionIds = new Set<string>([regionId]);
+  const queue = [regionId];
+  while (queue.length > 0) {
+    const current = queue.shift()!;
+    for (const child of index.childRegionsByRegionId.get(current) ?? []) {
+      if (!subtreeRegionIds.has(child.id)) {
+        subtreeRegionIds.add(child.id);
+        queue.push(child.id);
+      }
+    }
+  }
+  const subtreeObjectIds = new Set(graph.objects.filter((object) => subtreeRegionIds.has(object.regionId)).map((object) => object.id));
+  let internalLinkCount = 0;
+  let crossRegionLinkCount = 0;
+  for (const relationship of graph.relationships) {
+    const sourceInside = subtreeObjectIds.has(relationship.sourceObjectId);
+    const targetInside = subtreeObjectIds.has(relationship.targetObjectId);
+    if (sourceInside && targetInside) internalLinkCount += 1;
+    else if (sourceInside || targetInside) crossRegionLinkCount += 1;
+  }
+  const keyObjectNames = graph.objects
+    .filter((object) => subtreeObjectIds.has(object.id) && (object.importance.level === "critical" || object.importance.level === "high"))
+    .sort((left, right) => right.importance.score - left.importance.score || left.id.localeCompare(right.id))
+    .slice(0, keyObjectLimit)
+    .map((object) => object.name);
+  return {
+    objectCount: subtreeObjectIds.size,
+    internalLinkCount,
+    crossRegionLinkCount,
+    keyObjectNames,
+  };
+}
