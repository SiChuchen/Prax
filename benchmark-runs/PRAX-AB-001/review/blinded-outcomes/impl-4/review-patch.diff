+test("top-level Regions compose two-dimensionally instead of one strip", { timeout: 60_000 }, async () => {
+  for (const [name, graph] of Object.entries(CANVAS_FIXTURES)) {
+    const layout = await layoutSemanticGraph(graph);
+    const topLevelRects = topLevelRegionIds(graph)
+      .map((regionId) => layout.regionRects[regionId])
+      .filter(Boolean);
+    assert.ok(topLevelRects.length >= 2, `${name} fixture exercises multiple top-level Regions`);
+
+    for (let leftIndex = 0; leftIndex < topLevelRects.length; leftIndex += 1) {
+      for (let rightIndex = leftIndex + 1; rightIndex < topLevelRects.length; rightIndex += 1) {
+        assert.equal(overlap(topLevelRects[leftIndex], topLevelRects[rightIndex], 8), false, `${name}: packed Regions must not overlap`);
+      }
+    }
+
+    const rowTops = [...new Set(topLevelRects.map((rect) => Math.round(rect.y / 10)))].sort((left, right) => left - right);
+    for (const rowTop of rowTops) {
+      const row = topLevelRects.filter((rect) => Math.round(rect.y / 10) === rowTop);
+      const uniqueTops = new Set(row.map((rect) => rect.y));
+      assert.equal(uniqueTops.size, 1, `${name}: Regions in one row must share a top edge`);
+    }
+    if (name === "small" || name === "large") {
+      assert.ok(rowTops.length >= 2, `${name}: a multi-Region map must wrap into more than one row, received ${rowTops.length}`);
+    }
+    const aspect = layout.width / layout.height;
+    assert.ok(aspect > .35 && aspect < 3.2, `${name}: packed map aspect should stay viewport-like, received ${aspect.toFixed(2)}`);
+  }
+
+  const packedOnce = await layoutSemanticGraph(SMALL_CANVAS_FIXTURE);
+  const packedTwice = packTopLevelRegions(SMALL_CANVAS_FIXTURE, packedOnce);
+  assert.ok(packedTwice.rowCount >= 2, "Small fixture should pack into multiple rows");
+  assert.equal(packedTwice.topLevelRegionCount, topLevelRegionIds(SMALL_CANVAS_FIXTURE).length);
+  assert.deepEqual(packedTwice.layout.objectRects, packedOnce.objectRects, "Packing must be idempotent for an already packed map");
+});
