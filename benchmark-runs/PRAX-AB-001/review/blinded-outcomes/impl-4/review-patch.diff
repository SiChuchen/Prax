+    const descendantRegionIds = new Set(MEDIUM_CANVAS_FIXTURE.regions
+      .filter((candidate) => packedAncestorRegionId(MEDIUM_CANVAS_FIXTURE, candidate.id) === region.id)
+      .map((candidate) => candidate.id));
