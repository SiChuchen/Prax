+export function traceCorridor(graph: SemanticGraph, flowId: string | null | undefined): TraceCorridor | null {
+  const flow = graph.flows.find((candidate) => candidate.id === flowId);
+  if (!flow) return null;
+  const steps = [...flow.steps].sort((left, right) => left.sequence - right.sequence || left.id.localeCompare(right.id));
+  const stepById = new Map(steps.map((step) => [step.id, step]));
+  const referencedStepIds = new Set<string>();
+  for (const step of steps) for (const nextStepId of step.nextStepIds) referencedStepIds.add(nextStepId);
+  const ordered: TraceCorridorStep[] = steps.map((step) => ({
+    ...step,
+    isEntry: !referencedStepIds.has(step.id),
+    isExit: step.nextStepIds.length === 0,
+  }));
+  const transitions: TraceCorridorTransition[] = [];
+  for (const step of ordered) {
+    for (const nextStepId of step.nextStepIds) {
+      const next = stepById.get(nextStepId);
+      if (!next) continue;
+      const relationship = graph.relationships.find((candidate) =>
+        candidate.sourceObjectId === step.objectId && candidate.targetObjectId === next.objectId)
