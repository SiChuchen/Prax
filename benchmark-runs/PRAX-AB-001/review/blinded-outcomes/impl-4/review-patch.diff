+test("Trace renders an ordered corridor from entry to result", () => {
+  const flow = COMPLEX_CANVAS_FIXTURE.flows[0];
+  const corridor = traceCorridor(COMPLEX_CANVAS_FIXTURE, flow.id);
+  assert.ok(corridor, "A named Flow must produce a corridor");
+  assert.deepEqual(corridor.steps.map((step) => step.sequence), [...corridor.steps.keys()].map((index) => index + 1), "Corridor steps must be sequence-ordered");
+  assert.equal(corridor.steps[0].isEntry, true, "The first corridor step is the entry");
+  assert.equal(corridor.steps.at(-1).isExit, true, "The last corridor step is the result");
+  assert.ok(corridor.steps.filter((step) => step.isEntry).length >= 1);
+  assert.equal(corridor.transitions.length, corridor.steps.length - 1, "A linear Flow has one transition per consecutive step pair");
+  for (const transition of corridor.transitions) {
+    assert.ok(transition.payload.length > 0, "Every transition must name what it hands over");
+    assert.ok(transition.relationshipId.length > 0);
+  }
+  const forward = corridorTransitionBetween(corridor, corridor.transitions[0].fromObjectId, corridor.transitions[0].toObjectId);
+  assert.equal(forward?.relationshipId, corridor.transitions[0].relationshipId);
+  const reverse = corridorTransitionBetween(corridor, corridor.transitions[0].toObjectId, corridor.transitions[0].fromObjectId);
+  assert.equal(reverse?.relationshipId, corridor.transitions[0].relationshipId, "Corridor transitions are direction-agnostic lookups");
+  const isolated = COMPLEX_CANVAS_FIXTURE.objects.find((object) => !COMPLEX_CANVAS_FIXTURE.relationships.some((relationship) =>
+    relationship.sourceObjectId === object.id || relationship.targetObjectId === object.id));
+  assert.ok(isolated, "Complex fixture keeps an isolated object");
+  assert.equal(corridorTransitionBetween(corridor, corridor.steps[0].objectId, isolated.id), null, "Unrelated pairs have no corridor transition");
+  assert.equal(traceCorridor(COMPLEX_CANVAS_FIXTURE, "missing-flow"), null);
+});
