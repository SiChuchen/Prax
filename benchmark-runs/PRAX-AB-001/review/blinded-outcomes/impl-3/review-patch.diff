new file mode 100644
index 0000000..681dc14
--- /dev/null
+++ b/app/architecture/camera.ts
@@ -0,0 +1,47 @@
+export const ARCHITECTURE_ZOOM_FLOOR = 0.55;
+export const ARCHITECTURE_ZOOM_CEILING = 1;
+export const CANVAS_VIEW_PADDING = 0.08;
+export const SCREEN_TEXT_FLOOR = 12;
+export const LABEL_BASE_SIZE = 13;
+export const LABEL_COMPENSATION_MAX = 4.5;
+
+export type Size = { width: number; height: number };
+
+export type CameraBounds = { x: number; y: number; width: number; height: number };
+
+export type CameraViewport = { x: number; y: number; zoom: number };
+
+export function boundsOfRects(rects: Array<{ x: number; y: number; width: number; height: number }>): CameraBounds | null {
+  if (rects.length === 0) return null;
+  const left = Math.min(...rects.map((rect) => rect.x));
+  const top = Math.min(...rects.map((rect) => rect.y));
+  const right = Math.max(...rects.map((rect) => rect.x + rect.width));
+  const bottom = Math.max(...rects.map((rect) => rect.y + rect.height));
+  return { x: left, y: top, width: right - left, height: bottom - top };
+}
+
+export function architectureDensityViewport(
+  bounds: CameraBounds,
+  viewport: Size,
+  options: { padding?: number; zoomFloor?: number; zoomCeiling?: number } = {},
+): CameraViewport {
+  const padding = options.padding ?? CANVAS_VIEW_PADDING;
+  const zoomFloor = options.zoomFloor ?? ARCHITECTURE_ZOOM_FLOOR;
+  const zoomCeiling = options.zoomCeiling ?? ARCHITECTURE_ZOOM_CEILING;
+  const availableWidth = Math.max(1, viewport.width * (1 - padding * 2));
+  const availableHeight = Math.max(1, viewport.height * (1 - padding * 2));
+  const fitZoom = Math.min(availableWidth / Math.max(1, bounds.width), availableHeight / Math.max(1, bounds.height));
+  const zoom = Math.min(zoomCeiling, Math.max(zoomFloor, fitZoom));
+  const centerX = bounds.x + bounds.width / 2;
+  const centerY = bounds.y + bounds.height / 2;
+  return {
+    x: viewport.width / 2 - centerX * zoom,
+    y: viewport.height / 2 - centerY * zoom,
+    zoom,
+  };
+}
+
+export function screenSpaceLabelScale(zoom: number) {
+  const compensation = SCREEN_TEXT_FLOOR / (LABEL_BASE_SIZE * Math.max(zoom, 0.16));
+  return Math.min(LABEL_COMPENSATION_MAX, Math.max(1, compensation));
+}
