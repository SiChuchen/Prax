diff --git a/tests/canvas-readability.test.mjs b/tests/canvas-readability.test.mjs
new file mode 100644
index 0000000..dac6592
--- /dev/null
+++ b/tests/canvas-readability.test.mjs
@@ -0,0 +1,136 @@
+import assert from "node:assert/strict";
+import { register } from "node:module";
+import test from "node:test";
+
+register("./cloudflare-loader.mjs", import.meta.url);
+
+const { CANVAS_FIXTURES, COMPLEX_CANVAS_FIXTURE, MEDIUM_CANVAS_FIXTURE } = await import("../app/architecture/fixtures.ts");
+const { ARCHITECTURE_ZOOM_CEILING, ARCHITECTURE_ZOOM_FLOOR, architectureDensityViewport, screenSpaceLabelScale } = await import("../app/architecture/camera.ts");
+const { deriveCanvasView } = await import("../app/architecture/interaction.ts");
+const { compositionColumns, layoutSemanticGraph } = await import("../app/architecture/layout.ts");
+const { corridorStops, projectSemanticGraph } = await import("../app/architecture/projection.ts");
+
+function overlap(left, right, padding = 0) {
+  return left.x < right.x + right.width + padding && left.x + left.width + padding > right.x
+    && left.y < right.y + right.height + padding && left.y + left.height + padding > right.y;
+}
+
+test("top-level regions compose in two dimensions instead of one long strip", { timeout: 60_000 }, async () => {
+  for (const name of ["small", "medium", "large", "complex"]) {
+    const graph = CANVAS_FIXTURES[name];
+    const layout = await layoutSemanticGraph(graph);
+    const blockIds = layout.composition?.blockIds ?? [];
+    assert.ok(blockIds.length >= 2, `${name}: composition must engage for multi-block fixtures`);
+    const blocks = blockIds.map((id) => layout.regionRects[id]);
+    const rows = new Set(blocks.map((rect) => Math.round(rect.y / 100)));
+    const columns = new Set(blocks.map((rect) => Math.round(rect.x / 100)));
+    assert.ok(rows.size >= 2 || columns.size >= 2, `${name}: blocks must occupy a 2D grid, received ${rows.size} rows × ${columns.size} columns`);
+    if (blockIds.length >= 5) assert.ok(rows.size >= 2 && columns.size >= 2, `${name}: five or more blocks must wrap into multiple rows`);
+    for (let left = 0; left < blocks.length; left += 1) {
+      for (let right = left + 1; right < blocks.length; right += 1) {
+        assert.equal(overlap(blocks[left], blocks[right], 8), false, `${name}: composed blocks ${blockIds[left]} and ${blockIds[right]} overlap`);
+      }
+    }
+    const aspect = layout.width / layout.height;
+    assert.ok(aspect > .45 && aspect < 3, `${name}: composed canvas aspect ${aspect.toFixed(2)} must stay viewport-shaped`);
+  }
+});
+
+test("composition columns follow block proportions", () => {
+  assert.equal(compositionColumns(1), 1);
+  assert.equal(compositionColumns(2, 100, 100), 2);
+  assert.ok(compositionColumns(9, 100, 240) >= 4, "tall blocks need more columns to reach the target aspect");
+  assert.ok(compositionColumns(9, 240, 100) <= 5, "wide blocks must not exceed the column cap");
+});
+
+test("default camera anchors architecture density with a readable zoom floor", () => {
+  const stage = { width: 1280, height: 800 };
+  const huge = architectureDensityViewport({ x: 0, y: 0, width: 9000, height: 6000 }, stage);
+  assert.equal(huge.zoom, ARCHITECTURE_ZOOM_FLOOR, "oversized maps clamp to the architecture zoom floor instead of shrinking labels");
+  assert.ok(huge.zoom >= .48, "default zoom must stay inside the architecture semantic zoom band");
+
+  const small = architectureDensityViewport({ x: 0, y: 0, width: 1200, height: 700 }, stage);
+  assert.ok(small.zoom <= ARCHITECTURE_ZOOM_CEILING, "small maps must not zoom past the ceiling");
+
+  const bounds = { x: -500, y: -250, width: 1000, height: 500 };
+  const centered = architectureDensityViewport(bounds, stage);
+  const centerX = (centered.x + (bounds.x + bounds.width / 2) * centered.zoom);
+  const centerY = (centered.y + (bounds.y + bounds.height / 2) * centered.zoom);
+  assert.ok(Math.abs(centerX - stage.width / 2) < 1, "camera centers the composition horizontally");
+  assert.ok(Math.abs(centerY - stage.height / 2) < 1, "camera centers the composition vertically");
+
+  const docked = architectureDensityViewport({ x: 0, y: 0, width: 9000, height: 6000 }, { width: stage.width - 336, height: stage.height });
+  assert.equal(docked.zoom, ARCHITECTURE_ZOOM_FLOOR, "docked inspector keeps the readable zoom floor over the effective viewport");
+  assert.notDeepEqual(docked, huge);
+});
+
+test("labels are compensated to a screen-space text floor", () => {
+  assert.ok(screenSpaceLabelScale(ARCHITECTURE_ZOOM_FLOOR) > 1, "architecture-density zoom must compensate labels above 1");
+  assert.equal(screenSpaceLabelScale(1), 1);
+  assert.equal(screenSpaceLabelScale(.16), 4.5, "compensation is capped");
+  assert.ok(13 * screenSpaceLabelScale(.55) * .55 >= 11.9, "compensated labels render at the 12px screen floor");
+});
+
+test("regions carry a strong readable summary at every density", { timeout: 60_000 }, async () => {
+  const graph = MEDIUM_CANVAS_FIXTURE;
+  const layout = await layoutSemanticGraph(graph);
+  for (const zoom of [.35, .6, 1]) {
+    const view = deriveCanvasView(graph, { mode: "browse", selection: null, activeFlowId: null, zoom, searchQuery: "" });
+    const projection = projectSemanticGraph(graph, layout, view);
+    const regionNodes = projection.nodes.filter((node) => node.type === "region");
+    assert.ok(regionNodes.length > 0);
+    for (const node of regionNodes) {
+      assert.equal(node.data.typeCounts.length > 0, node.data.objectCount > 0, "region summary lists its object composition");
+      assert.ok(node.data.keyObjectNames.length <= 3);
+      assert.ok(typeof node.data.zoom === "number" && node.data.zoom > 0, "region nodes receive zoom for screen-space label compensation");
+    }
+  }
+});
+
+test("relationship density is graded: intra-region edges recede at architecture density", { timeout: 60_000 }, async () => {
+  const graph = MEDIUM_CANVAS_FIXTURE;
+  const layout = await layoutSemanticGraph(graph);
+  const view = deriveCanvasView(graph, { mode: "browse", selection: null, activeFlowId: null, zoom: .6, searchQuery: "" });
+  const projection = projectSemanticGraph(graph, layout, view);
+  const relationshipEdges = projection.edges.filter((edge) => edge.type === "relationship");
+  const regionOf = new Map(graph.objects.map((object) => [object.id, object.regionId]));
+  for (const edge of relationshipEdges) {
+    const expected = regionOf.get(edge.source) !== regionOf.get(edge.target);
+    assert.equal(edge.data.interRegion, expected, `edge ${edge.id} interRegion flag must reflect region membership`);
+  }
+  assert.ok(relationshipEdges.some((edge) => edge.data.interRegion), "medium fixture must contain inter-region edges");
+  assert.ok(relationshipEdges.some((edge) => !edge.data.interRegion), "medium fixture must contain intra-region edges");
+});
+
+test("trace renders an ordered corridor with entry and result over the stable map", { timeout: 60_000 }, async () => {
+  const graph = COMPLEX_CANVAS_FIXTURE;
+  const layout = await layoutSemanticGraph(graph);
+  const flow = graph.flows[0];
+  const view = deriveCanvasView(graph, { mode: "trace", selection: { kind: "flow", id: flow.id }, activeFlowId: flow.id, zoom: .7, searchQuery: "" });
+  const projection = projectSemanticGraph(graph, layout, view);
+
+  const stops = corridorStops(flow.steps);
+  assert.ok(stops.length >= 2, "flow must produce corridor stops");
+  for (let index = 1; index < stops.length; index += 1) {
+    assert.ok(stops[index - 1].sequence <= stops[index].sequence, "corridor stops keep flow sequence order");
+  }
+
+  const corridorEdges = projection.edges.filter((edge) => edge.type === "corridor");
+  assert.equal(corridorEdges.length, stops.length - 1, "corridor must connect every consecutive stop");
+  for (const edge of corridorEdges) {
+    assert.ok(edge.data.fromSequence < edge.data.toSequence, "corridor transitions are strictly ordered");
+    assert.equal(edge.data.flowId, flow.id);
+  }
+  const orders = corridorEdges.map((edge) => edge.data.order);
+  assert.deepEqual(orders, [...orders].sort((left, right) => left - right), "corridor edge order is monotonic");
+
+  const objectNodes = new Map(projection.nodes.filter((node) => node.type === "object").map((node) => [node.id, node]));
+  assert.equal(objectNodes.get(stops[0].objectId)?.data.flowRole, "entry", "first corridor stop is the entry");
+  assert.equal(objectNodes.get(stops[stops.length - 1].objectId)?.data.flowRole, "result", "last corridor stop is the result");
+  for (const stop of stops.slice(1, -1)) {
+    assert.equal(objectNodes.get(stop.objectId)?.data.flowRole, "step");
+  }
+
+  const layoutAgain = await layoutSemanticGraph(graph, { previousLayout: layout });
+  assert.deepEqual(layoutAgain.objectRects, layout.objectRects, "trace must be a lens: reopening the same graph keeps the stable map");
+});
