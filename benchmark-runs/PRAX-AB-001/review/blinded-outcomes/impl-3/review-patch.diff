@@ -0,0 +1,36 @@
+"use client";
+
+import { BaseEdge, EdgeLabelRenderer, getSmoothStepPath, type Edge, type EdgeProps } from "@xyflow/react";
+import { screenSpaceLabelScale } from "./camera";
+import type { CorridorEdgeData } from "./types";
+
+export type CanvasCorridorEdgeComponent = Edge<CorridorEdgeData, "corridor">;
+
+export default function CorridorEdge(props: EdgeProps<CanvasCorridorEdgeComponent>) {
+  const [path, labelX, labelY] = getSmoothStepPath({
+    sourceX: props.sourceX,
+    sourceY: props.sourceY,
+    sourcePosition: props.sourcePosition,
+    targetX: props.targetX,
+    targetY: props.targetY,
+    targetPosition: props.targetPosition,
+    borderRadius: 12,
+    offset: 28,
+  });
+  const scale = Math.min(2, screenSpaceLabelScale(props.data?.zoom ?? 1));
+  return (
+    <g className="trace-corridor-edge">
+      <BaseEdge id={props.id} interactionWidth={12} path={path} />
+      <EdgeLabelRenderer>
+        <div
+          className="corridor-transition nodrag nopan"
+          style={{ transform: `translate(-50%, -50%) translate(${labelX}px,${labelY}px) scale(${scale})` }}
+          title={props.data?.transition}
+        >
+          <b>{props.data?.order}</b>
+          <span>{props.data?.fromSequence}→{props.data?.toSequence}</span>
+        </div>
+      </EdgeLabelRenderer>
+    </g>
+  );
+}
