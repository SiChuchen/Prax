+// The trace corridor is the ordered main path of a Flow: walk from its entry
+// steps, following the lowest-sequence next step at each branch, until the
+// outcome. Deterministic; cycles stop before revisiting a step.
+export function deriveTraceCorridor(graph: SemanticGraph, flowId: string | null): TraceCorridorStep[] {
+  const flow = flowId ? graph.flows.find((candidate) => candidate.id === flowId) : undefined;
+  if (!flow || flow.steps.length === 0) return [];
+  const steps = [...flow.steps].sort((left, right) => left.sequence - right.sequence || left.id.localeCompare(right.id));
+  const stepById = new Map(steps.map((step) => [step.id, step]));
+  const referencedStepIds = new Set(steps.flatMap((step) => step.nextStepIds));
+  const nextOf = (step: SemanticFlowStep): SemanticFlowStep | undefined => step.nextStepIds
+    .map((id) => stepById.get(id))
+    .filter((candidate): candidate is SemanticFlowStep => Boolean(candidate))
+    .sort((left, right) => left.sequence - right.sequence || left.id.localeCompare(right.id))[0];
+
+  const walk = (start: SemanticFlowStep): SemanticFlowStep[] => {
+    const visited = new Set<string>();
+    const path: SemanticFlowStep[] = [];
+    let cursor: SemanticFlowStep | undefined = start;
+    while (cursor && !visited.has(cursor.id)) {
+      visited.add(cursor.id);
+      path.push(cursor);
+      cursor = nextOf(cursor);
+    }
+    return path;
+  };
+
+  const entrySteps = steps.filter((step) => !referencedStepIds.has(step.id));
+  const walks = (entrySteps.length > 0 ? entrySteps : [steps[0]]).map(walk);
+  const main = walks.sort((left, right) => right.length - left.length || left[0].sequence - right[0].sequence)[0];
+
+  return main.map((step, index) => {
+    const next = index + 1 < main.length ? main[index + 1] : undefined;
+    if (!next || next.objectId === step.objectId) {
+      return { stepId: step.id, objectId: step.objectId, sequence: step.sequence, role: step.role, title: step.title };
+    }
+    const relationship = graph.relationships.find((candidate) =>
+      (candidate.sourceObjectId === step.objectId && candidate.targetObjectId === next.objectId)
+      || (candidate.sourceObjectId === next.objectId && candidate.targetObjectId === step.objectId));
+    const payload = step.outputs.length > 0 ? step.outputs.join(" + ") : next.inputs.join(" + ");
+    const transitionRole = index === 0 ? "entry" : index + 2 === main.length ? "exit" : "step";
+    return {
+      stepId: step.id,
+      objectId: step.objectId,
+      sequence: step.sequence,
+      role: step.role,
+      title: step.title,
+      transitionPayload: payload || undefined,
+      transitionRelationshipId: relationship?.id,
+      transitionRole,
+    };
+  });
+}
