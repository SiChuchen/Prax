new file mode 100644
index 0000000..760b4d9
--- /dev/null
+++ b/app/architecture/camera.ts
@@ -0,0 +1,64 @@
+import type { CanvasLayout } from "./layout";
+
+// Readability is measured in SCREEN space, not in pre-fit world-space node width.
+export const READABILITY = {
+  objectLabelPx: 15,
+  regionHeaderPx: 13,
+  labelScreenFloor: 13,
+  objectMinScreenWidth: 170,
+  minObjectWorldWidth: 232,
+} as const;
+
+// The default camera never opens below this zoom: Region headers and key Object
+// labels stay readable and the view stays in the Architecture density band.
+export const DEFAULT_ZOOM_FLOOR = 0.75;
+export const DEFAULT_FIT_MAX_ZOOM = 1.05;
+export const DEFAULT_FRAME_PADDING = 0.1;
+export const DOCK_WIDTH = { inspector: 336, flowLens: 316 } as const;
+
+export type SemanticZoomLevels = "landscape" | "architecture" | "component" | "operational";
+
+export function objectLabelScale(zoom: number, zoomLevel: SemanticZoomLevels) {
+  if (zoomLevel !== "landscape" && zoomLevel !== "architecture") return 1;
+  const target = READABILITY.labelScreenFloor / READABILITY.objectLabelPx;
+  const cap = zoomLevel === "landscape" ? 4.5 : 2.2;
+  return Math.min(cap, Math.max(1, target / Math.max(zoom, 0.16)));
+}
+
+export function regionLabelScale(zoom: number) {
+  const target = READABILITY.labelScreenFloor / READABILITY.regionHeaderPx;
+  return Math.min(3.2, Math.max(1, target / Math.max(zoom, 0.16)));
+}
+
+// Frame the initial camera on the top-level Region composition. Fitting may not
+// push zoom below the readability floor — off-screen geometry is preferred over
+// an unreadable thumbnail.
+export function frameTopRegions(layout: CanvasLayout) {
+  const topLevelIds = Object.values(layout.regionRects)
+    .filter((rect) => rect.parentRegionId === undefined)
+    .map((rect) => rect.id);
+  const targetIds = topLevelIds.length > 0
+    ? topLevelIds
+    : Object.values(layout.regionRects).filter((rect) => rect.depth === 0).map((rect) => rect.id);
+  return {
+    nodes: targetIds.map((id) => ({ id })),
+    padding: DEFAULT_FRAME_PADDING,
+    minZoom: DEFAULT_ZOOM_FLOOR,
+    maxZoom: DEFAULT_FIT_MAX_ZOOM,
+  };
+}
+
+// When a dock opens or closes, the effective viewport changes by the dock width.
+// Shift the camera by half the dock delta on the dock's side so the content the
+// reader was looking at stays centred in the effective viewport instead of
+// hiding under the dock.
+export function dockViewportShift(
+  previous: { left: number; right: number },
+  next: { left: number; right: number },
+) {
+  return -(next.right - previous.right) / 2 + (next.left - previous.left) / 2;
+}
+
+export function effectiveScreenObjectWidth(worldWidth: number, zoom: number) {
+  return worldWidth * zoom;
+}
