+test("top-level Regions compose two-dimensionally instead of one strip", { timeout: 60_000 }, async () => {
+  for (const [name, graph] of Object.entries(CANVAS_FIXTURES)) {
+    const layout = await layoutSemanticGraph(graph);
+    const membership = compositionMembership(graph);
+    const memberIds = [...new Set(membership.values())];
+    const memberRects = memberIds.map((id) => layout.regionRects[id]);
+    if (memberRects.length < 2) continue;
+
+    for (let left = 0; left < memberRects.length; left += 1) {
+      for (let right = left + 1; right < memberRects.length; right += 1) {
+        assert.equal(overlap(memberRects[left], memberRects[right]), false, `${name}: composition members must not overlap`);
+      }
+    }
+
+    const distinctRows = new Set(memberRects.map((rect) => Math.round(rect.y)));
+    assert.ok(distinctRows.size >= 2 || memberRects.length < 4, `${name}: ${memberRects.length} Regions must compose in more than one row`);
+
+    const aspect = layout.width / layout.height;
+    assert.ok(aspect > .3 && aspect < 3.6, `${name}: composed map aspect ${aspect.toFixed(2)} (w=${layout.width}, h=${layout.height}) must approach the viewport instead of a long strip`);
+  }
+});
