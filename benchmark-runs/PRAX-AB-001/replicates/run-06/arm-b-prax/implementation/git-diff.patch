+test("Trace projects an ordered corridor with Region summaries", async () => {
+  const layout = await layoutSemanticGraph(SMALL_CANVAS_FIXTURE);
+  const flow = SMALL_CANVAS_FIXTURE.flows[0];
+  const view = deriveCanvasView(SMALL_CANVAS_FIXTURE, {
+    mode: "trace",
+    selection: { kind: "flow", id: flow.id },
+    activeFlowId: flow.id,
+    zoom: .9,
+    searchQuery: "",
+  });
+  const { nodes, edges } = projectSemanticGraph(SMALL_CANVAS_FIXTURE, layout, view);
+
+  const objectNodesById = new Map(nodes.filter((node) => node.type === "object").map((node) => [node.id, node]));
+  const entryStep = flow.steps.find((step) => step.role === "entry");
+  const exitStep = flow.steps.find((step) => step.role === "exit");
+  assert.ok(entryStep && exitStep, "Fixture flows must declare entry and exit roles");
+  assert.ok(objectNodesById.has(entryStep.objectId), "Entry object must be on the map");
+  assert.ok(objectNodesById.has(exitStep.objectId), "Exit object must be on the map");
+
+  for (const step of flow.steps) {
+    const node = objectNodesById.get(step.objectId);
+    assert.ok(node, `Step object ${step.objectId} must be visible in the corridor`);
+    const sequences = node.data.flowSteps.map((flowStep) => flowStep.sequence);
+    assert.deepEqual(sequences, [...sequences].sort((left, right) => left - right), "Per-object flow step badges must follow main-path sequence order");
+    if (step.objectId === entryStep.objectId) {
+      assert.ok(node.data.flowSteps.some((flowStep) => flowStep.role === "entry"), "Entry object must carry an entry marker");
+    }
+  }
+
+  const activeEdges = edges.filter((edge) => edge.data.emphasis === "active");
+  assert.ok(activeEdges.length >= 2, "The corridor must emphasize its ordered transitions");
+  for (const edge of activeEdges) {
+    assert.ok(edge.data.flowSequence !== undefined, `Corridor edge ${edge.id} must carry its step sequence`);
+    assert.ok(edge.data.flowPayload, `Corridor edge ${edge.id} must carry its transition payload`);
+  }
+
+  const anyRegion = nodes.find((node) => node.type === "region");
+  assert.equal(typeof anyRegion.data.criticalCount, "number", "Region nodes must expose a critical-object roll-up");
+  assert.equal(typeof anyRegion.data.highCount, "number", "Region nodes must expose a high-importance roll-up");
+  assert.ok(Array.isArray(anyRegion.data.keyObjectNames), "Region nodes must expose key object names that survive Object withholding");
+});
